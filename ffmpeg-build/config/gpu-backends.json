{
    "cpu": {
        "enabled": true,
        "description": "Software encoding using libx264/libx265/libvpx/libaom.",
        "ffmpegFlags": [
            "--enable-gpl",
            "--enable-libx264",
            "--enable-libx265",
            "--enable-libvpx",
            "--enable-libaom",
            "--enable-libsvtav1",
            "--enable-static",
            "--disable-shared",
            "--pkg-config-flags=--static",
            "--extra-ldexeflags=-static",
            "--extra-ldflags=-static"
        ]
    },
    "amd": {
        "vaapi": {
            "enabled": true,
            "description": "AMD GPU encoding on Linux via VAAPI. Works in Docker.",
            "packages": [
                "mesa-va-drivers",
                "libva-dev",
                "libdrm-dev"
            ],
            "ffmpegFlags": [
                "--enable-vaapi",
                "--enable-libdrm"
            ]
        },
        "amf": {
            "enabled": false,
            "description": "AMF hardware encoding. Fully supported on Windows. Linux support is experimental.",
            "ffmpegFlags": [
                "--enable-amf"
            ]
        }
    },
    "nvidia": {
        "nvenc": {
            "enabled": true,
            "description": "NVIDIA hardware encoding (H.264/H.265/AV1). Best GPU encoder quality.",
            "packages": [],
            "ffmpegFlags": [
                "--enable-nonfree",
                "--enable-nvenc",
                "--enable-cuda",
                "--enable-cuvid",
                "--enable-nvdec"
            ]
        }
    },
    "intel": {
        "qsv": {
            "enabled": false,
            "description": "Intel QuickSync hardware encoding. Works on Linux and Windows.",
            "packages": [
                "intel-media-va-driver-non-free",
                "intel-opencl-icd"
            ],
            "ffmpegFlags": [
                "--enable-libvpl"
            ]
        },
        "vaapi": {
            "enabled": true,
            "description": "Intel VAAPI hardware encoding. Works in Docker.",
            "packages": [
                "intel-media-va-driver-non-free",
                "libva-dev",
                "libdrm-dev"
            ],
            "ffmpegFlags": [
                "--enable-vaapi",
                "--enable-libdrm"
            ]
        }
    }
}